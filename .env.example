# Copy this file to .env or run scripts/init-env.ps1|sh.
# Values below are intentionally convenient and insecure. Use generated secrets even for shared dev.
COMPOSE_PROJECT_NAME=airflow-template
AIRFLOW_IMAGE_NAME=airflow-template:2.8.4-python3.11
AIRFLOW_VERSION=2.8.4
PYTHON_VERSION=3.11
AIRFLOW_UID=50000

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Valid development-only Fernet key (32 zero bytes encoded as urlsafe base64).
FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AIRFLOW_WEBSERVER_SECRET_KEY=change-me-before-use

AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_FLOWER_PORT=5555
AIRFLOW_LOG_LEVEL=INFO
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_DAGS_PAUSED_AT_CREATION=true
AIRFLOW_WORKER_CONCURRENCY=2

