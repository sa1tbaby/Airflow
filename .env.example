# Root environment source for Ubuntu 22.04.
# Sections are for readability only; scripts identify values by variable name.
# Use KEY=VALUE lines and full-line comments; inline comments are intentionally unsupported.
# Copying is optional: `sh scripts/init-env.sh` creates `.env` when it is absent.

# =============================================================================
# Project and pinned runtime versions
# =============================================================================
COMPOSE_PROJECT_NAME=airflow-template
AIRFLOW_IMAGE_NAME=airflow-template:2.8.4-python3.11
AIRFLOW_VERSION=2.8.4
PYTHON_VERSION=3.11

# =============================================================================
# Ubuntu host
# =============================================================================
# AUTO is replaced with the current Linux user ID on the first render.
AIRFLOW_UID=AUTO

# =============================================================================
# Docker Compose: PostgreSQL
# =============================================================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=GENERATE_ME
POSTGRES_DB=airflow

# =============================================================================
# Docker Compose: Airflow administrator and cryptographic secrets
# =============================================================================
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=GENERATE_ME
FERNET_KEY=GENERATE_ME
AIRFLOW_WEBSERVER_SECRET_KEY=GENERATE_ME

# =============================================================================
# Docker Compose: runtime settings
# =============================================================================
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_FLOWER_PORT=5555
AIRFLOW_LOG_LEVEL=INFO
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_DAGS_PAUSED_AT_CREATION=true
AIRFLOW_WORKER_CONCURRENCY=2

# =============================================================================
# Kubernetes Secret rendering
# =============================================================================
# Enable after replacing the metadata connection. URI credentials must be percent-encoded.
K8S_SECRETS_ENABLED=false
K8S_NAMESPACE=airflow
K8S_METADATA_CONNECTION=REPLACE_ME_POSTGRESQL_CONNECTION
# KubernetesExecutor does not need a broker. Enable this only for CeleryExecutor.
K8S_BROKER_SECRET_ENABLED=false
K8S_BROKER_URL=REPLACE_ME_REDIS_OR_AMQP_CONNECTION
K8S_FERNET_KEY=GENERATE_ME
K8S_WEBSERVER_SECRET_KEY=GENERATE_ME

