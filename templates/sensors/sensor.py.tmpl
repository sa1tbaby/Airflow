"""Custom sensor template using Airflow 2's public sensor API."""

from pathlib import Path
from typing import Any

from airflow.sensors.base import BaseSensorOperator
from airflow.utils.context import Context


class FileReadySensor(BaseSensorOperator):
    """Wait for a path visible to every worker.

    Prefer a maintained provider sensor for real projects. This implementation is a small extension
    template that demonstrates keeping filesystem I/O inside ``poke``.
    """

    template_fields = ("path",)

    def __init__(self, *, path: str, mode: str = "reschedule", **kwargs: Any) -> None:
        super().__init__(mode=mode, **kwargs)
        self.path = path

    def poke(self, context: Context) -> bool:
        return Path(self.path).is_file()
